{% comment %}
  Custom Product Grid Section
  - 6 product blocks
  - Popup on circle click
  - Products selectable from customizer
{% endcomment %}

<style>
  .custom-product-grid {
    max-width: 1400px;
    margin: 60px auto;
    padding: 0 20px;
  }

  .custom-product-grid__title {
    text-align: center;
    font-size: 36px;
    margin-bottom: 50px;
    font-weight: 700;
  }

  .custom-product-grid__container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .product-card {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .product-card__image-wrapper {
    position: relative;
    width: 100%;
    padding-top: 100%;
    overflow: hidden;
  }

  .product-card__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Circle Button */
  .product-card__hotspot {
    position: absolute;
    width: 40px;
    height: 40px;
    background: white;
    border-radius: 50%;
    border: 3px solid #667eea;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 10;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.7);
    }
    50% {
      transform: scale(1.05);
      box-shadow: 0 0 0 10px rgba(102, 126, 234, 0);
    }
  }

  .product-card__hotspot:hover {
    transform: scale(1.1);
    background: #667eea;
  }

  .product-card__hotspot::after {
    content: '+';
    font-size: 24px;
    color: #667eea;
    font-weight: 700;
  }

  .product-card__hotspot:hover::after {
    color: white;
  }

  .product-card__info {
    padding: 20px;
    background: white;
  }

  .product-card__title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 10px;
    color: #333;
  }

  .product-card__price {
    font-size: 20px;
    font-weight: 700;
    color: #667eea;
  }

  @media (max-width: 1024px) {
    .custom-product-grid__container {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 640px) {
    .custom-product-grid__container {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .custom-product-grid__title {
      font-size: 28px;
      margin-bottom: 30px;
    }
  }
</style>

<div class="custom-product-grid">
  {% if section.settings.section_title != blank %}
    <h2 class="custom-product-grid__title">{{ section.settings.section_title }}</h2>
  {% endif %}

  <div class="custom-product-grid__container">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}

      {% if product != blank %}
        <div class="product-card" data-product-id="{{ product.id }}">
          
          <div class="product-card__image-wrapper">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 600 | image_tag: 
  class: 'product-card__image',
  alt: product.title,
  loading: 'lazy'
}}
            {% else %}
              <div class="product-card__image" style="background: #f0f0f0;"></div>
            {% endif %}

            {% comment %} Circle Hotspot Button {% endcomment %}
            <button 
              type="button"
              class="product-card__hotspot"
              style="top: {{ block.settings.hotspot_top }}%; left: {{ block.settings.hotspot_left }}%;"
              data-product-handle="{{ product.handle }}"
              aria-label="View {{ product.title | escape }} details"
            ></button>

          </div>

          <div class="product-card__info">
            <h3 class="product-card__title">{{ product.title }}</h3>
            <div class="product-card__price">
              {{ product.price | money }}
            </div>
          </div>

        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Featured Products"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "range",
          "id": "hotspot_top",
          "label": "Hotspot Position (Top %)",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_left",
          "label": "Hotspot Position (Left %)",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}